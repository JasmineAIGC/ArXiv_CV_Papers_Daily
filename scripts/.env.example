# 复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 忽略，不会提交到 Git）
DOUBAO_API_KEY=your_doubao_api_key_here
CHATGLM_API_KEY=your_chatglm_api_key_here

# LLM 模型选择开关: doubao（豆包）/ glm（智谱GLM）/ deepseek（DeepSeek）
LLM_PROVIDER=doubao

# 具体模型名称（按需修改）
DOUBAO_MODEL=doubao-1-5-lite-32k-250115
CHATGLM_MODEL=glm-5.1
DEEPSEEK_MODEL=deepseek-flash

# DeepSeek（深度求索）配置
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_ENABLE_THINKING=False
